.hero {
  background: linear-gradient(135deg, #021f58 0%, #0552d4 54%, #0660f3 100%);
  color: #ffffff;
}

.hero .muted {
  color: rgba(255, 255, 255, 0.78);
}

.section {
  margin-top: 28rpx;
}

.notice {
  box-sizing: border-box;
  padding: 24rpx;
  border: 1rpx solid #b8d4ff;
  border-radius: 18rpx;
  background: #e7f0fe;
  color: #021f58;
  font-size: 26rpx;
  line-height: 1.5;
}

.picker-value {
  color: #1a1a1a;
}

.status-message {
  margin-top: 12rpx;
  color: #6b7280;
  font-size: 24rpx;
}

.knowledge-list {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
  margin-top: 16rpx;
}

.knowledge-item {
  padding: 18rpx 20rpx;
  border: 1rpx solid #dcdcdc;
  border-radius: 14rpx;
  background: #ffffff;
  color: #1a1a1a;
  font-size: 26rpx;
}

.knowledge-item.active {
  border-color: #0660f3;
  background: #e7f0fe;
  color: #0552d4;
  font-weight: 600;
}

.secondary {
  background: #ffffff;
  color: #0660f3;
  border: 1rpx solid #a8c7f7;
}
